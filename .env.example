# Copy this file to .env and fill in your own values. Never commit .env.
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=energy
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Optional: AWS (Phase 5). Leave empty to skip the S3 upload step. ---
# See docs/AWS_SETUP.md. Credentials are NOT stored here: they live in
# ~/.aws/credentials (created by "aws configure"), selected by AWS_PROFILE.
S3_BUCKET=
AWS_PROFILE=energy-pipeline
AWS_DEFAULT_REGION=eu-central-1

# --- Optional: LLM daily summary (Phase 6). Leave empty to skip. ---
# API key from the Anthropic Console (one summary costs about 1 cent)
ANTHROPIC_API_KEY=
