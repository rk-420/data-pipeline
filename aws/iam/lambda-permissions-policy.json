{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteRawDataOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::YOUR_BUCKET/raw/*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-central-1:YOUR_ACCOUNT_ID:log-group:/aws/lambda/energy-extract:*"
    }
  ]
}
